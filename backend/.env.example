# ──────────────────────────────────────────────────────────────────
# INFRASTRUCTURE ONLY. Everything about the site's content, branding,
# contact info, hours, feature toggles, etc. is configured through the
# admin panel at runtime, not here — see app/settings_registry.py.
# ──────────────────────────────────────────────────────────────────

ENVIRONMENT=development

# sqlite:///./data/perennia.db for local dev (default if unset).
# postgresql://user:pass@host:5432/dbname or mysql://user:pass@host/dbname in prod.
DATABASE_URL=sqlite:///./data/perennia.db

HOST=127.0.0.1
PORT=8001

# Comma-separated. Leave empty for same-origin only.
ALLOWED_ORIGINS=http://localhost:5173

# Generate both with: python scripts/gen_secrets.py
# Required in production; auto-generated ephemerally in dev if left blank.
SECRET_KEY=
ENCRYPTION_KEY=

# Bootstrap admin — only used by scripts/init_db.py on first run, when no
# admin account exists yet. Get the hash from scripts/gen_secrets.py.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD_HASH=

SESSION_TTL_SECONDS=3600
# false only for local http-only dev
COOKIE_SECURE=true

RATE_LIMIT_LOGIN=5/minute
