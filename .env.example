# ──────────────────────────────────────────────────────────
# Vite only exposes env vars prefixed VITE_ to client code
# (via import.meta.env). This is read once, at build time.
# ──────────────────────────────────────────────────────────

# Where the header logo image is served from. Read by
# src/components/ui/Logo.jsx. Points at public/static/logo.svg by
# default, which Vite serves as-is at that same path in both `npm
# run dev` and the built `dist/` output.
#
# To swap the logo: replace public/static/logo.svg with the real
# artwork (keep the filename, or update this path to match), or
# point this at any URL your backend/CDN serves the file from —
# e.g. VITE_LOGO_URL=http://localhost:8000/uploads/logo.png in dev,
# or an absolute https:// URL in production. No component changes
# needed either way.
VITE_LOGO_URL=static/logo.svg
